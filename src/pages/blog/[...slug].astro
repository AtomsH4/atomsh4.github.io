---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../../lib/content';
import '../../components/ReadOnlyTable/ReadOnlyTable.css';

export async function getStaticPaths() {
  const entries = getPublishedEntries(await getCollection('blog'));

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} | AtomsH4`}
  description={entry.data.summary}
  article={{ title: entry.data.title, pubDate: entry.data.pubDate }}
>
  <PageHero
    eyebrow="Blog"
    title={entry.data.title}
    description={entry.data.summary}
  />
  <article class="prose blog-article">
    <Content />
  </article>
</BaseLayout>

<style>
  :global(main:has(> .blog-article)) {
    min-width: 0;
  }

  :global(main:has(> .blog-article) > .page-hero) {
    max-width: var(--content-prose);
    margin-inline: auto;
  }

  :global(main:has(> .blog-article) > .page-hero h1) {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .blog-article {
    min-width: 0;
    max-width: var(--content-prose);
    margin-inline: auto;
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    font-size: 0.875em;
    line-height: 1.6;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .prose :global(a) {
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .prose :global(figure) {
    margin: var(--space-8) 0;
  }

  .prose :global(figure a) {
    display: block;
    border-radius: var(--radius-md);
    cursor: zoom-in;
  }

  .prose :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .prose :global(figcaption) {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: 0.875em;
    line-height: 1.6;
  }
</style>
