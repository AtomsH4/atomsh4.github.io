---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedEntries } from '../../lib/content';
import '../../styles/article.css';

export async function getStaticPaths() {
  const entries = getPublishedEntries(await getCollection('notes'));

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'notes'> };
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} | AtomsH4`}
  description={entry.data.summary}
  article={{ title: entry.data.title, pubDate: entry.data.pubDate }}
>
  <PageHero
    eyebrow="Notes"
    title={entry.data.title}
    description={entry.data.summary}
  />
  <article class="prose reading-article notes-article">
    <Content />
  </article>
</BaseLayout>
