---
type Props = {
  title: string;
  summary: string;
  pubDate: Date;
  tags: string[];
  href: string;
  kind?: 'own' | 'fork' | 'member';
  repository?: string;
  variant?: 'blog' | 'note' | 'project';
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
};

const {
  title, summary, pubDate, tags, href, kind, repository,
  variant = 'blog', featured = false, headingLevel = 'h2',
} = Astro.props;
const Heading = headingLevel;
const formattedPubDate = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
const titleLinksToRepository = href === repository;
---

<article class:list={[
  'entry-card',
  `entry-card--${variant}`,
  { 'entry-card--featured': featured },
]}>
  <div class="entry-body">
    {featured && <p class="entry-feature-label">最新文章</p>}
    {kind && <p class="entry-kind">{kind}</p>}
    <Heading class="entry-title">
      {titleLinksToRepository ? (
        title
      ) : (
        <a href={href}>{title}</a>
      )}
    </Heading>
    <p class="entry-summary">{summary}</p>
  </div>
  <div class="entry-meta">
    <div class="entry-meta-row">
      <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
      {!repository && <span class="entry-arrow" aria-hidden="true">→</span>}
    </div>
    <ul aria-label="标签">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  {repository && (
    <a
      class="entry-repository"
      href={repository}
      target="_blank"
      rel="noreferrer"
      aria-label={`打开 ${title} 仓库（在新标签页打开）`}
    >
      <span>打开仓库<span class="sr-only">（在新标签页打开）</span></span>
      <span aria-hidden="true">↗</span>
    </a>
  )}
</article>
