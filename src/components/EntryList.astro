---
import EmptyState from './EmptyState.astro';
import EntryCard from './EntryCard.astro';
import { joinBasePath } from '../lib/site-path';

type Entry = {
  id: string;
  data: {
    title: string;
    summary: string;
    pubDate: Date;
    tags: string[];
    kind?: 'own' | 'fork' | 'member';
    repository?: string;
  };
};

type Props = {
  entries: Entry[];
  emptyMessage: string;
  collection: string;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
};

const { entries, emptyMessage, collection, featured = false, headingLevel } = Astro.props;
const variant = collection === 'notes' ? 'note' : collection === 'projects' ? 'project' : 'blog';
const getEntryHref = (entry: Entry) =>
  entry.data.repository ??
  joinBasePath(import.meta.env.BASE_URL, `/${collection}/${entry.id}/`);
---

{entries.length === 0 ? (
  <EmptyState message={emptyMessage} />
) : (
  <div class:list={['entry-grid', `entry-grid--${collection}`, { 'entry-grid--featured': featured }]}>
    {entries.map((entry, index) => (
      <EntryCard
        title={entry.data.title}
        summary={entry.data.summary}
        pubDate={entry.data.pubDate}
        tags={entry.data.tags}
        href={getEntryHref(entry)}
        kind={entry.data.kind}
        repository={entry.data.repository}
        variant={variant}
        featured={featured && index === 0}
        headingLevel={headingLevel}
      />
    ))}
  </div>
)}
