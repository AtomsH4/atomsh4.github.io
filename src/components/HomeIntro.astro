---
import HomeSignature from './HomeSignature.astro';
---

<home-intro class="home-intro" aria-hidden="true">
  <div class="home-intro-visual" data-intro-visual>
    <div class="home-intro-backdrop"></div>
    <div class="home-intro-artwork" data-intro-artwork>
      <HomeSignature idPrefix="intro-signature" />
    </div>
  </div>
</home-intro>

<script>
  import '../features/home/home-intro';
</script>

<style>
  :global(html:has(home-intro)) {
    scrollbar-gutter: stable;
  }

  :global(body:has(home-intro[data-active])) {
    overflow: hidden;
  }

  :global(body:has(home-intro[data-active]) [data-signature-target] > svg) {
    visibility: hidden;
  }

  .home-intro {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: block;
    color: var(--color-accent-deep);
    cursor: pointer;
    animation: home-intro-exit 800ms cubic-bezier(0.4, 0, 0.2, 1) 3.15s forwards;
  }

  .home-intro-visual {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--page-gutter);
    isolation: isolate;
  }

  .home-intro-backdrop {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(ellipse at 18% 30%, var(--home-glow-cyan), transparent 65%),
      radial-gradient(ellipse at 80% 36%, var(--home-glow-violet), transparent 64%),
      radial-gradient(ellipse at 65% 82%, var(--home-glow-pink), transparent 60%),
      var(--home-page);
  }

  .home-intro[data-enhanced] {
    animation: none;
  }

  .home-intro[hidden] {
    display: none;
  }

  .home-intro-artwork {
    width: min(100%, 72rem, 123.2svh);
    aspect-ratio: 1540 / 450;
    transform-origin: top left;
    will-change: transform;
  }

  @keyframes home-intro-exit {
    to {
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-intro {
      display: none;
      animation: none;
    }

    .home-intro-artwork {
      animation: none;
    }
  }
</style>
