---
import { joinBasePath } from '../lib/site-path';

export type Props = {
  title: string;
  description: string;
  article?: { title: string; pubDate: Date };
  noindex?: boolean;
};

const { title, description, article, noindex = false } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
if (!canonical.pathname.endsWith('/') && !canonical.pathname.endsWith('.html')) {
  canonical.pathname += '/';
}
const image = new URL(joinBasePath(basePath, '/media/site/social.png'), Astro.site);
const author = new URL(joinBasePath(basePath, '/about/'), Astro.site);
const structuredData = article && !noindex ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonical.href}#article`,
  mainEntityOfPage: canonical.href,
  headline: article.title,
  description,
  image: [image.href],
  datePublished: article.pubDate.toISOString(),
  author: { '@type': 'Person', name: 'AtomsH4', url: author.href },
  inLanguage: 'zh-CN',
} : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/svg+xml" href={joinBasePath(basePath, '/favicon.svg')} />
<link rel="sitemap" href={joinBasePath(basePath, '/sitemap-index.xml')} />
<meta property="og:site_name" content="AtomsH4" />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="AtomsH4：技术实践与项目记录" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />
<meta name="twitter:image:alt" content="AtomsH4：技术实践与项目记录" />
{article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
{article && <meta property="article:author" content={author.href} />}
{structuredData && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  />
)}
