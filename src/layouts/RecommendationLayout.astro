---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SeoHead, { type Props } from '../components/SeoHead.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SeoHead {...Astro.props} />
  </head>
  <body class="recommendation-theme">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  html:has(body.recommendation-theme) {
    --recommendation-page: #ebe5db;
    --recommendation-page-accent-rgb: 196 79 50;

    background-color: var(--recommendation-page);
    background-image:
      radial-gradient(circle at 12% 4%, rgb(255 255 255 / 74%), transparent 30%),
      radial-gradient(
        circle at 88% 18%,
        rgb(var(--recommendation-page-accent-rgb) / 24%),
        transparent 34%
      ),
      radial-gradient(
        circle at 14% 78%,
        rgb(var(--recommendation-page-accent-rgb) / 16%),
        transparent 38%
      );
    background-attachment: fixed;
  }

  html:has(
      body.recommendation-theme
        [data-recommendation-experience][data-category='book']
    ) {
    --recommendation-page-accent-rgb: 173 118 31;
  }

  html:has(
      body.recommendation-theme
        [data-recommendation-experience][data-category='screen']
    ) {
    --recommendation-page-accent-rgb: 71 114 85;
  }

  .recommendation-theme {
    --recommendation-ink: #302b24;
    --color-page: var(--recommendation-page);
    --color-text: var(--recommendation-ink);
    --color-muted: #6f665b;
    --color-accent: #8a5d1b;
    --color-accent-deep: #3d342a;
    --color-surface: rgb(255 252 246 / 54%);
    --color-surface-strong: rgb(255 252 246 / 76%);
    --color-border: rgb(255 255 255 / 72%);
    --color-nav-active: rgb(255 252 246 / 72%);
    --color-menu: #f9f6ef;
    --color-card-border: rgb(90 70 40 / 12%);
    --color-rule: rgb(90 70 40 / 14%);
    --shadow-glass: 0 24px 70px rgb(75 61 42 / 13%);
    --shadow-soft: 0 14px 38px rgb(75 61 42 / 9%);
    color-scheme: light;
    color: var(--recommendation-ink);
    background: transparent;
  }

  .recommendation-theme .site-header {
    margin-top: 1rem;
    border-color: rgb(255 255 255 / 74%);
    border-radius: var(--radius-lg);
    background: rgb(255 252 246 / 56%);
    box-shadow: var(--shadow-glass), inset 0 1px 0 rgb(255 255 255 / 82%);
    backdrop-filter: blur(24px) saturate(118%);
    -webkit-backdrop-filter: blur(24px) saturate(118%);
  }

  .recommendation-theme main {
    width: 100%;
    margin: 1.25rem 0 2rem;
    padding-inline: 0;
  }

  .recommendation-theme .site-footer {
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .recommendation-theme main {
      margin-top: 0.75rem;
    }
  }
</style>
